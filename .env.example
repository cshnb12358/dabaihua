# ── DeepSeek API ──────────────────────────────────────────
# 在 https://platform.deepseek.com 注册获取
DEEPSEEK_API_KEY=sk-your-api-key-here

# 模型选择
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 缓存 ─────────────────────────────────────────────────
CACHE_ENABLED=true

# ── OCR ───────────────────────────────────────────────────
OCR_ENABLED=true
OCR_BACKEND=paddleocr

# ── 服务器 ───────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
# 生产模式：true=前端和后端部署在一起，访问根路径即可
PRODUCTION=true

# ── 微信公众号（可选，个人订阅号也支持）──────────────────
# 公众号后台 → 设置与开发 → 基本配置 → 开发者ID(AppID)
WECHAT_APPID=wx_your_appid_here
# 公众号后台 → 设置与开发 → 基本配置 → 开发者密码(AppSecret)
WECHAT_APPSECRET=your_appsecret_here
