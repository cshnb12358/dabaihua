# ── LLM API 配置（通用）────────────────────────────────────
# 当前使用：千问（阿里云百炼）
LLM_API_KEY=sk-09c408c2a459483d8df0feb02972e306
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# ── 切换千问（阿里云百炼）──────────────────────────────────
# 1. 打开 https://dashscope.console.aliyun.com
# 2. 获取 API Key
# 3. 把上面三行改成：
# LLM_API_KEY=sk-你的千问key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 千问模型选择：
#   qwen-turbo    — 最快最便宜，简单题够了
#   qwen-plus     — 性价比最高（推荐）
#   qwen-max      — 最强，复杂逻辑题用
#   qwen-plus-latest / qwen-max-latest — 最新版本

# ── DeepSeek 兼容（旧配置仍可用作备选）─────────────────────
DEEPSEEK_API_KEY=sk-cfb2f610e7c8493ca4bfba8068026061
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

